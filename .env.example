# Database
DATABASE_URL=postgresql://propflow:propflow@localhost:5432/propflow_db

# JWT
JWT_SECRET=change-this-to-a-256-bit-random-secret
JWT_EXPIRES_IN=7d

# Admin self-registration passcode (used on /link-admin and /portal/register).
# Leave blank to disable admin self-registration.
ADMIN_SETUP_CODE=

# After deploy, Web Portal login is at:
#   https://YOUR_RAILWAY_DOMAIN/portal/login
# LIFF (LINE mobile) remains separate.

# LINE Messaging API channel (OA)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Login channel (LIFF)
LINE_LOGIN_CHANNEL_ID=
LIFF_ID=

# App URLs
FRONTEND_URL=https://liff.line.me/YOUR_LIFF_ID
LIFF_BASE_URL=https://liff.line.me/YOUR_LIFF_ID
BACKEND_URL=http://localhost:4000
PORT=4000
NODE_ENV=development

# Cloudflare R2 (recommended — S3-compatible, free tier generous)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=propflow-uploads

# Legacy AWS S3 (optional — leave blank if using R2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_REGION=ap-southeast-1

# SMS (Twilio) - optional, mock mode if blank
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# PromptPay (Admin default for rent QR, overridden per-property)
DEFAULT_PROMPTPAY_NUMBER=0812345678

# Platform SaaS subscription (Owner pays PropFlow service fee)
PLATFORM_PROMPTPAY_NUMBER=
SUBSCRIPTION_PRICE=499
SUBSCRIPTION_PERIOD_DAYS=30
SUBSCRIPTION_GRACE_DAYS=7
SUBSCRIPTION_TRIAL_DAYS=14
SUBSCRIPTION_REMIND_DAYS=7,3,1
SUBSCRIPTION_REMIND_TIME=09:00

# Slip OCR (optional — easyslip.com)
# SLIP_VERIFY_PROVIDER=mock
# SLIP_VERIFY_PROVIDER=easyslip
# EASYSLIP_API_KEY=

# Frontend env (Vite prefix)
VITE_LIFF_ID=
VITE_API_URL=http://localhost:4000/api
