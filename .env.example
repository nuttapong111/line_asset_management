# Database
DATABASE_URL=postgresql://propflow:propflow@localhost:5432/propflow_db

# JWT
JWT_SECRET=change-this-to-a-256-bit-random-secret
JWT_EXPIRES_IN=7d

# Admin self-registration passcode (used on the /link-admin screen).
# Leave blank to disable admin self-registration.
ADMIN_SETUP_CODE=

# LINE Messaging API channel (OA)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Login channel (LIFF)
LINE_LOGIN_CHANNEL_ID=
LIFF_ID=

# App URLs
FRONTEND_URL=https://liff.line.me/YOUR_LIFF_ID
LIFF_BASE_URL=https://liff.line.me/YOUR_LIFF_ID
BACKEND_URL=http://localhost:4000
PORT=4000
NODE_ENV=development

# AWS S3 (optional - falls back to local disk if blank)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=propflow-uploads
AWS_REGION=ap-southeast-1

# SMS (Twilio) - optional, mock mode if blank
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# PromptPay (Admin default, overridden per-property)
DEFAULT_PROMPTPAY_NUMBER=0812345678

# Frontend env (Vite prefix)
VITE_LIFF_ID=
VITE_API_URL=http://localhost:4000/api
