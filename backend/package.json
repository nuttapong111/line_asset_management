{
  "name": "propflow-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "migrate": "prisma migrate dev",
    "deploy:migrate": "prisma migrate deploy",
    "generate": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "reset:db": "tsx scripts/resetDatabase.ts",
    "reset:db:seed": "tsx scripts/resetDatabase.ts --seed",
    "gen:richmenu": "tsx scripts/genRichMenu.ts",
    "gen:richmenu:admin": "tsx scripts/genAdminRichMenu.ts",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@line/bot-sdk": "^9.2.2",
    "@prisma/client": "^5.16.1",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.0",
    "promptpay-qr": "^0.5.0",
    "twilio": "^4.23.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.13.4",
    "prisma": "^5.16.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3"
  }
}
